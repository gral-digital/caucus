# ==========================================================================
# Avvocato — environment variables (dev example)
# Copia questo file in .env e personalizza. Il .env non va committato.
# ==========================================================================

# ---- Runtime ----
APP_ENV=local                       # local | dev | prod
LOG_LEVEL=INFO

# ---- Postgres (primary datastore) ----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=avvocato
POSTGRES_PASSWORD=avvocato
POSTGRES_DB=avvocato
DATABASE_URL=postgresql+asyncpg://avvocato:avvocato@localhost:5432/avvocato

# ---- Qdrant (vector DB) ----
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=local-dev-key
QDRANT_COLLECTION_CODICI=codici
QDRANT_COLLECTION_LEGGI=leggi
QDRANT_COLLECTION_CASSAZIONE=cassazione

# ---- Redis ----
REDIS_URL=redis://localhost:6379/0

# ---- Object storage (MinIO in local, GCS in prod) ----
STORAGE_PROVIDER=minio              # minio | gcs
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=avvocato
STORAGE_SECRET_KEY=avvocato-dev-minio
STORAGE_BUCKET_DOCUMENTS=avvocato-documents
STORAGE_BUCKET_SOURCES=avvocato-sources

# ---- Langfuse (LLM tracing) ----
LANGFUSE_HOST=http://localhost:3001
LANGFUSE_PUBLIC_KEY=                # genera dopo setup langfuse
LANGFUSE_SECRET_KEY=

# ---- LLM routing (LiteLLM) ----
# Config dettagliata in apps/api/litellm_config.yaml
LLM_ROUTER_CONFIG=apps/api/litellm_config.yaml

# Modello primario (via Vertex AI in prod, via Ollama/endpoint locale in dev)
LLM_PRIMARY_MODEL=vertex_ai/llama-3.3-70b-instruct
LLM_FALLBACK_MODEL=vertex_ai/claude-sonnet-4-5

# Embeddings
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024

# Reranker
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# ---- GCP (Vertex AI, GCS, Cloud SQL in prod) ----
GCP_PROJECT=                        # es. avvocato-dev
GCP_REGION=europe-west1
GOOGLE_APPLICATION_CREDENTIALS=     # path al service account JSON (solo dev)

# Anthropic via Vertex (non via API diretta)
ANTHROPIC_VERTEX_PROJECT_ID=
ANTHROPIC_VERTEX_REGION=europe-west1

# ---- Auth (fase 1: Clerk) ----
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# ---- Web (Next.js) ----
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Ingestion ----
NORMATTIVA_USER_AGENT=AvvocatoBot/0.1 (contact: dev@avvocato.it)
INGESTION_RATE_LIMIT_PER_SECOND=1
