# ==========================================================================
# Caucus: environment variables (dev example)
# Copia questo file in .env e personalizza. Il .env non va committato.
# ==========================================================================

# ---- Runtime ----
APP_ENV=local                       # local | dev | prod
LOG_LEVEL=INFO

# ---- Postgres (primary datastore) ----
POSTGRES_HOST=localhost
POSTGRES_PORT=55432
POSTGRES_USER=avvocato
POSTGRES_PASSWORD=avvocato
POSTGRES_DB=avvocato
DATABASE_URL=postgresql+asyncpg://avvocato:avvocato@localhost:55432/avvocato

# ---- Qdrant (vector DB) ----
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=local-dev-key
QDRANT_COLLECTION_CODICI=codici
QDRANT_COLLECTION_LEGGI=leggi
QDRANT_COLLECTION_CASSAZIONE=cassazione

# ---- Redis ----
REDIS_URL=redis://localhost:6379/0

# ---- Object storage (MinIO in local, GCS in prod) ----
STORAGE_PROVIDER=minio              # minio | gcs
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=avvocato
STORAGE_SECRET_KEY=avvocato-dev-minio
STORAGE_BUCKET_DOCUMENTS=caucus-documents
STORAGE_BUCKET_SOURCES=caucus-sources

# ---- Langfuse (LLM tracing) ----
LANGFUSE_HOST=http://localhost:3001
LANGFUSE_PUBLIC_KEY=                # genera dopo setup langfuse
LANGFUSE_SECRET_KEY=

# ---- LLM backend selection ----
# 'openai' = SaaS (consigliato), 'ollama' = dev offline, 'vertex' = GCP prod
LLM_BACKEND=openai
EMBEDDING_BACKEND=openai

# ---- OpenAI (SaaS) ----
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ---- Ollama (solo dev offline) ----
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=qwen3:8b
OLLAMA_EMBEDDING_MODEL=bge-m3

# ---- LLM routing (OpenAI via LiteLLM) ----
LLM_PRIMARY_MODEL=openai/gpt-4o-mini
LLM_FALLBACK_MODEL=openai/gpt-4o

# Embeddings (1536-dim con text-embedding-3-small; re-indicizza se cambi dim)
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# Reranker (auto = keyword boost; oppure cohere/local/noop)
RERANKER_BACKEND=auto
COHERE_API_KEY=
COHERE_RERANK_MODEL=rerank-multilingual-v3.0
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# ---- GCP (Vertex AI, GCS, Cloud SQL in prod) ----
GCP_PROJECT=                        # es. caucus-dev
GCP_REGION=europe-west1
GOOGLE_APPLICATION_CREDENTIALS=     # path al service account JSON (solo dev)

# Anthropic via Vertex (non via API diretta)
ANTHROPIC_VERTEX_PROJECT_ID=
ANTHROPIC_VERTEX_REGION=europe-west1

# ---- Auth (fase 1: Clerk) ----
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# ---- Web (Next.js) ----
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Ingestion ----
NORMATTIVA_USER_AGENT=CaucusBot/0.1 (+https://github.com/caucus-legal)
INGESTION_RATE_LIMIT_PER_SECOND=1

# ---- API security (Fase 0) ----
# Token condiviso per /chat e /search (header: Authorization: Bearer <token>
# oppure X-API-Key). Obbligatorio con APP_ENV != local (fail-closed).
API_AUTH_TOKEN=
# Origini CORS ammesse (comma-separated). In prod: dominio pubblico del frontend.
CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:3100,http://127.0.0.1:3000,http://127.0.0.1:3100
# Richieste/minuto per IP su /chat e /search (0 = disabilitato).
RATE_LIMIT_PER_MINUTE=30
